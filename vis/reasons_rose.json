{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Top reasons for getting each type of pet (rose charts; wedge area is proportional to percent)",
  "data": {
    "url": "data/reasons_for_getting_pet.csv"
  },
  "transform": [
    {
      "window": [
        {
          "op": "row_number",
          "as": "rk"
        }
      ],
      "groupby": [
        "pet"
      ],
      "sort": [
        {
          "field": "percent",
          "order": "descending"
        }
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "count",
          "as": "n"
        }
      ],
      "groupby": [
        "pet"
      ]
    },
    {
      "calculate": "(datum.rk - 1) * 2 * PI / datum.n",
      "as": "a0"
    },
    {
      "calculate": "datum.a0 + 2 * PI / datum.n",
      "as": "a1"
    },
    {
      "calculate": "(datum.a0 + datum.a1) / 2",
      "as": "amid"
    }
  ],
  "facet": {
    "field": "pet",
    "type": "nominal",
    "sort": [
      "Dogs",
      "Cats",
      "Small mammals",
      "Birds",
      "Fish",
      "Reptiles"
    ],
    "header": {
      "title": null,
      "labelFontSize": 15,
      "labelFontWeight": "bold",
      "labelPadding": 7
    }
  },
  "spec": {
    "width": 174,
    "height": 150,
    "layer": [
      {
        "mark": {
          "type": "arc",
          "stroke": "#FAF7F2",
          "strokeWidth": 1.5
        },
        "encoding": {
          "theta": {
            "field": "a0",
            "type": "quantitative",
            "scale": null
          },
          "theta2": {
            "field": "a1"
          },
          "radius": {
            "field": "percent",
            "type": "quantitative",
            "scale": {
              "type": "sqrt",
              "zero": true,
              "domain": [
                0,
                60
              ],
              "range": [
                0,
                65
              ]
            }
          },
          "color": {
            "field": "reason",
            "type": "nominal",
            "sort": [
              "Companionship",
              "Relaxation",
              "Mental health",
              "Hobby",
              "Low maintenance",
              "Rescue / give a home",
              "Good temperament"
            ],
            "scale": {
              "domain": [
                "Companionship",
                "Relaxation",
                "Mental health",
                "Hobby",
                "Low maintenance",
                "Rescue / give a home",
                "Good temperament"
              ],
              "range": [
                "#7A2E4D",
                "#C48CA0",
                "#5B6F94",
                "#A9B6CE",
                "#8F8472",
                "#D9B8A6",
                "#CFC8B8"
              ]
            },
            "legend": {
              "title": null,
              "orient": "bottom",
              "columns": 3,
              "symbolType": "square",
              "labelFontSize": 12
            }
          },
          "tooltip": [
            {
              "field": "pet",
              "title": "Pet"
            },
            {
              "field": "reason",
              "title": "Reason"
            },
            {
              "field": "percent",
              "title": "% of owners"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "text",
          "radiusOffset": 9,
          "fontSize": 12,
          "fontWeight": "bold",
          "color": "#2b2a26"
        },
        "encoding": {
          "theta": {
            "field": "amid",
            "type": "quantitative",
            "scale": null
          },
          "radius": {
            "field": "percent",
            "type": "quantitative",
            "scale": {
              "type": "sqrt",
              "zero": true,
              "domain": [
                0,
                60
              ],
              "range": [
                0,
                65
              ]
            }
          },
          "text": {
            "field": "percent",
            "type": "quantitative",
            "format": ".0f"
          }
        }
      }
    ]
  },
  "resolve": {
    "scale": {
      "color": "shared"
    }
  },
  "config": {
    "view": {
      "stroke": null
    }
  },
  "columns": 3
}
