{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Horizontal bars: share of each group that owns a pet, with the 73% national average marked",
  "data": {
    "url": "data/who_owns_pets.csv"
  },
  "width": "container",
  "height": {
    "step": 28
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": {
          "band": 0.7
        }
      },
      "encoding": {
        "y": {
          "field": "label",
          "type": "nominal",
          "sort": {
            "field": "rate",
            "order": "descending"
          },
          "axis": {
            "title": null,
            "labelLimit": 0,
            "labelFontSize": 13,
            "ticks": false,
            "domain": false,
            "labelPadding": 8
          }
        },
        "x": {
          "field": "rate",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "title": "Share of the group that has a pet (%)",
            "values": [
              0,
              20,
              40,
              60,
              80,
              100
            ]
          }
        },
        "color": {
          "field": "direction",
          "type": "nominal",
          "scale": {
            "domain": [
              "Above average",
              "Below average"
            ],
            "range": [
              "#A64E32",
              "#C4AD99"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "symbolType": "square",
            "labelFontSize": 13
          }
        },
        "tooltip": [
          {
            "field": "group",
            "title": "Group"
          },
          {
            "field": "theme",
            "title": "Type of group"
          },
          {
            "field": "rate",
            "title": "Have a pet (%)"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#242B37"
      },
      "encoding": {
        "y": {
          "field": "label",
          "type": "nominal",
          "sort": {
            "field": "rate",
            "order": "descending"
          },
          "axis": {
            "title": null,
            "labelLimit": 0,
            "labelFontSize": 13,
            "ticks": false,
            "domain": false,
            "labelPadding": 8
          }
        },
        "x": {
          "field": "rate",
          "type": "quantitative"
        },
        "text": {
          "field": "rate",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 73
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [
          4,
          3
        ],
        "color": "#242B37",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 73,
            "t": "National average: 73%"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "dx": 6,
        "dy": -4,
        "fontSize": 12,
        "fontStyle": "italic",
        "color": "#4E596B"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "value": 0
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}