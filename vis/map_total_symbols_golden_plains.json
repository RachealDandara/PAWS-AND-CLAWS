{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Council map fitted to its own boundary; each uses official ABS boundaries.",
  "width": 270,
  "height": 310,
  "title": {
    "text": "Golden Plains · VIC",
    "fontSize": 14,
    "anchor": "middle"
  },
  "projection": {
    "type": "mercator",
    "scale": 16514,
    "translate": [
      -41330.1,
      -11648.0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/council_boundaries.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F2EEE7",
        "stroke": "#9CA89D",
        "strokeWidth": 0.8
      },
      "transform": [
        {
          "filter": {
            "field": "properties.council",
            "equal": "Golden Plains Shire"
          }
        }
      ]
    },
    {
      "data": {
        "url": "data/suburb_map_points.csv"
      },
      "mark": {
        "type": "circle",
        "opacity": 0.62,
        "stroke": "#ffffff",
        "strokeWidth": 0.4
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "total",
          "type": "quantitative",
          "title": "Registered records",
          "scale": {
            "range": [
              12,
              1100
            ],
            "domain": [
              0,
              3346
            ]
          },
          "legend": null
        },
        "color": {
          "value": "#C76B4E"
        },
        "tooltip": [
          {
            "field": "council",
            "title": "Council"
          },
          {
            "field": "suburb",
            "title": "Suburb"
          },
          {
            "field": "total",
            "title": "Records",
            "format": ","
          },
          {
            "field": "Cat",
            "title": "Cats"
          },
          {
            "field": "Dog",
            "title": "Dogs"
          }
        ]
      },
      "transform": [
        {
          "filter": {
            "field": "council",
            "equal": "Golden Plains Shire"
          }
        }
      ]
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "background": null
  }
}