{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Waffle charts: of every 100 dogs and 100 cats, how many were adopted and how many were bought",
  "data": {
    "url": "data/adoption_waffle.csv"
  },
  "facet": {
    "column": {
      "field": "pet",
      "type": "nominal",
      "sort": [
        "Dogs",
        "Cats"
      ],
      "header": {
        "title": null,
        "labelFontSize": 16,
        "labelFontWeight": "bold"
      }
    }
  },
  "spec": {
    "width": {
      "step": 22
    },
    "height": {
      "step": 22
    },
    "mark": {
      "type": "square",
      "size": 330,
      "opacity": 1
    },
    "encoding": {
      "x": {
        "field": "x",
        "type": "ordinal",
        "axis": null
      },
      "y": {
        "field": "y",
        "type": "ordinal",
        "axis": null
      },
      "color": {
        "field": "source",
        "type": "nominal",
        "scale": {
          "domain": [
            "Adopted or rehomed",
            "Bought from a breeder or pet shop"
          ],
          "range": [
            "#234B3A",
            "#cdbb9a"
          ]
        },
        "legend": {
          "title": null,
          "orient": "bottom",
          "columns": 1,
          "symbolType": "square",
          "labelFontSize": 13,
          "labelLimit": 340
        }
      }
    }
  },
  "config": {
    "view": {
      "stroke": null
    }
  }
}