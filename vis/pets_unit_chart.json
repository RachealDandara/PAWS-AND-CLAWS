{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Each square is 250,000 pets in Australia, 2025",
  "data": {
    "url": "data/pets_units.csv",
    "format": {
      "type": "csv",
      "parse": {
        "x": "number",
        "y": "number"
      }
    }
  },
  "width": {
    "step": 24
  },
  "height": {
    "step": 24
  },
  "mark": {
    "type": "square",
    "size": 380,
    "opacity": 1,
    "stroke": "#A18A7C",
    "strokeWidth": 0.45
  },
  "encoding": {
    "x": {
      "field": "x",
      "type": "ordinal",
      "axis": null,
      "sort": "ascending"
    },
    "y": {
      "field": "y",
      "type": "ordinal",
      "axis": null,
      "sort": "ascending"
    },
    "color": {
      "field": "label",
      "type": "nominal",
      "sort": {
        "field": "y",
        "op": "min"
      },
      "scale": {
        "range": [
          "#FFFDF9",
          "#A64E32",
          "#A16B4D",
          "#D9A441",
          "#C77B58",
          "#F0C56B",
          "#BE9067"
        ]
      },
      "legend": {
        "title": null,
        "orient": "bottom",
        "columns": 4,
        "symbolType": "square",
        "labelFontSize": 14,
        "labelLimit": 0,
        "labelColor": "#FFF9F2",
        "symbolStrokeColor": "#C9B5A7",
        "symbolStrokeWidth": 0.8,
        "labelPadding": 6
      }
    }
  }
}
