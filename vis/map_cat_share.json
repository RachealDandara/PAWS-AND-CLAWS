{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Three independently fitted council maps; each uses official ABS boundaries.",
  "hconcat": [
    {
      "width": 270,
      "height": 310,
      "title": {
        "text": "Townsville \u00b7 QLD",
        "fontSize": 14,
        "anchor": "middle"
      },
      "projection": {
        "type": "mercator"
      },
      "layer": [
        {
          "data": {
            "url": "data/council_boundaries.geojson",
            "format": {
              "type": "json",
              "property": "features"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#F2EEE7",
            "stroke": "#9CA89D",
            "strokeWidth": 0.8
          },
          "transform": [
            {
              "filter": {
                "field": "properties.council",
                "equal": "Townsville City Council"
              }
            }
          ]
        },
        {
          "data": {
            "url": "data/suburb_pet_boundaries.geojson",
            "format": {
              "type": "json",
              "property": "features"
            }
          },
          "mark": {
            "type": "geoshape",
            "stroke": "#FFFFFF",
            "strokeWidth": 0.25
          },
          "encoding": {
            "color": {
              "field": "properties.cat_share",
              "type": "quantitative",
              "title": "Cat share (%)",
              "scale": {
                "scheme": "yellowgreenblue"
              }
            },
            "tooltip": [
              {
                "field": "properties.council",
                "title": "Council"
              },
              {
                "field": "properties.suburb",
                "title": "Suburb"
              },
              {
                "field": "properties.Cat",
                "title": "Cats",
                "format": ","
              },
              {
                "field": "properties.Dog",
                "title": "Dogs",
                "format": ","
              },
              {
                "field": "properties.cat_share",
                "title": "Cat share (%)"
              }
            ]
          },
          "transform": [
            {
              "filter": {
                "field": "properties.council",
                "equal": "Townsville City Council"
              }
            }
          ]
        }
      ]
    },
    {
