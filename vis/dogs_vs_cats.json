{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dogs and cats compared on six measures",
  "data": {
    "url": "data/dogs_vs_cats.csv"
  },
  "width": "container",
  "height": {
    "step": 44
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 4,
        "color": "#e2dccf"
      },
      "encoding": {
        "y": {
          "field": "measure",
          "type": "nominal",
          "sort": null,
          "axis": {
            "title": null,
            "labelLimit": 340,
            "labelFontSize": 13,
            "ticks": false,
            "domain": false
          }
        },
        "x": {
          "field": "Dogs",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "title": "Percent of dogs or cats (%)",
            "grid": true,
            "gridColor": "#e8e2d6",
            "tickCount": 6
          }
        },
        "x2": {
          "field": "Cats"
        }
      }
    },
    {
      "transform": [
        {
          "fold": [
            "Dogs",
            "Cats"
          ],
          "as": [
            "series",
            "value"
          ]
        }
      ],
      "mark": {
        "type": "circle",
        "size": 170,
        "opacity": 1
      },
      "encoding": {
        "y": {
          "field": "measure",
          "type": "nominal",
          "sort": null,
          "axis": {
            "title": null,
            "labelLimit": 340,
            "labelFontSize": 13,
            "ticks": false,
            "domain": false
          }
        },
        "x": {
          "field": "value",
          "type": "quantitative"
        },
        "color": {
          "field": "series",
          "type": "nominal",
          "scale": {
            "domain": [
              "Dogs",
              "Cats"
            ],
            "range": [
              "#C76B4E",
              "#234B3A"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "symbolSize": 170
          }
        }
      }
    },
    {
      "transform": [
        {
          "calculate": "min(datum['Dogs'], datum['Cats'])",
          "as": "lo"
        },
        {
          "calculate": "max(datum['Dogs'], datum['Cats'])",
          "as": "hi"
        },
        {
          "calculate": "datum.lo + '%'",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -11,
        "fontSize": 12,
        "color": "#2b2a26"
      },
      "encoding": {
        "y": {
          "field": "measure",
          "type": "nominal",
          "sort": null,
          "axis": {
            "title": null,
            "labelLimit": 340,
            "labelFontSize": 13,
            "ticks": false,
            "domain": false
          }
        },
        "x": {
          "field": "lo",
          "type": "quantitative"
        },
        "text": {
          "field": "lab",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "calculate": "min(datum['Dogs'], datum['Cats'])",
          "as": "lo"
        },
        {
          "calculate": "max(datum['Dogs'], datum['Cats'])",
          "as": "hi"
        },
        {
          "calculate": "datum.hi + '%'",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 11,
        "fontSize": 12,
        "color": "#2b2a26"
      },
      "encoding": {
        "y": {
          "field": "measure",
          "type": "nominal",
          "sort": null,
          "axis": {
            "title": null,
            "labelLimit": 340,
            "labelFontSize": 13,
            "ticks": false,
            "domain": false
          }
        },
        "x": {
          "field": "hi",
          "type": "quantitative"
        },
        "text": {
          "field": "lab",
          "type": "nominal"
        }
      }
    }
  ]
}