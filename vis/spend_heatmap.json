{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Average yearly spend per household by item and pet type",
  "data": {
    "url": "data/spend_by_category.csv"
  },
  "width": {
    "step": 84
  },
  "height": {
    "step": 27
  },
  "encoding": {
    "x": {
      "field": "pet_label",
      "type": "nominal",
      "sort": [
        "Dogs\n$2,520",
        "Small mammals\n$2,095",
        "Cats\n$1,656",
        "Reptiles\n$1,319",
        "Birds\n$555",
        "Fish\n$475"
      ],
      "axis": {
        "orient": "top",
        "title": null,
        "labelAngle": 0,
        "labelFontSize": 12,
        "labelLineHeight": 15,
        "labelPadding": 26,
        "ticks": false,
        "labelExpr": "split(datum.label, '\\n')"
      }
    },
    "y": {
      "field": "category",
      "type": "nominal",
      "sort": [
        "Food",
        "Veterinary services",
        "Products or accessories",
        "Pet insurance",
        "Flea, worming and tick treatments",
        "Dietary supplements",
        "Clipping and grooming",
        "Training and behaviour",
        "Competitions and memberships",
        "Veterinary medicines",
        "Walking",
        "Alternative healthcare",
        "Boarding and minding",
        "Transport",
        "Pet healthcare products"
      ],
      "axis": {
        "title": null,
        "labelLimit": 240,
        "ticks": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "color": {
          "field": "dollars",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "domain": [
              0,
              1100
            ],
            "range": [
              "#c3d6d0",
              "#234B3A"
            ]
          },
          "legend": {
            "title": "Dollars a year",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 260
          }
        },
        "tooltip": [
          {
            "field": "pet_label",
            "title": "Pet"
          },
          {
            "field": "category",
            "title": "Expense"
          },
          {
            "field": "dollars",
            "title": "Average yearly spending",
            "format": "$,.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11
      },
      "encoding": {
        "text": {
          "field": "dollars",
          "type": "quantitative",
          "format": "$,.0f"
        },
        "color": {
          "condition": {
            "test": "datum.dollars >= 450",
            "value": "white"
          },
          "value": "#2b2a26"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}