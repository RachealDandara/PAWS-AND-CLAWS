{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "100% stacked bars of attitudes to adoption; response percentages reported by AMA, 2025",
  "data": {
    "url": "data/adoption_attitudes.csv"
  },
  "width": "container",
  "height": {
    "step": 54
  },
  "mark": {
    "type": "bar",
    "height": {
      "band": 0.7
    }
  },
  "encoding": {
    "y": {
      "field": "statement",
      "type": "nominal",
      "sort": [
        "Would adopt a rescue pet next time",
        "No need to buy when shelters are full",
        "Rescues are not riskier than bought pets"
      ],
      "axis": {
        "title": null,
        "labelLimit": 300,
        "labelFontSize": 12
      }
    },
    "x": {
      "aggregate": "sum",
      "field": "percent",
      "type": "quantitative",
      "stack": "normalize",
      "axis": {
        "title": "Share of respondents (%)",
        "format": ".0%"
      }
    },
    "color": {
      "field": "view",
      "type": "nominal",
      "scale": {
        "domain": [
          "Strongly against",
          "Somewhat against",
          "Neutral or might consider",
          "Somewhat for",
          "Strongly for"
        ],
        "range": [
          "#b5483c",
          "#e3a58f",
          "#e6e0d3",
          "#7fa592",
          "#234B3A"
        ]
      },
      "legend": {
        "title": null,
        "orient": "top",
        "columns": 3
      }
    },
    "order": {
      "field": "x0",
      "type": "quantitative",
      "sort": "ascending"
    },
    "tooltip": [
      {
        "field": "statement",
        "title": "Statement"
      },
      {
        "field": "view",
        "title": "Response"
      },
      {
        "field": "percent",
        "title": "Respondents (%)"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    }
  }
}