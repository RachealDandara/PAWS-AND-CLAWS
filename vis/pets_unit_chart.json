{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Each square is 250,000 pets in Australia, 2025",
  "data": {
    "url": "data/pets_units.csv",
    "format": {
      "type": "csv",
      "parse": {
        "x": "number",
        "y": "number"
      }
    }
  },
  "width": {
    "step": 24
  },
  "height": {
    "step": 24
  },
  "mark": {
    "type": "square",
    "size": 380,
    "opacity": 1
  },
  "encoding": {
    "x": {
      "field": "x",
      "type": "ordinal",
      "axis": null,
      "sort": "ascending"
    },
    "y": {
      "field": "y",
      "type": "ordinal",
      "axis": null,
      "sort": "ascending"
    },
    "color": {
      "field": "label",
      "type": "nominal",
      "sort": {
        "field": "y",
        "op": "min"
      },
      "scale": {
        "range": [
          "#3F7C8C",
          "#C76B4E",
          "#234B3A",
          "#D9A441",
          "#8a6f4d",
          "#A8B89A",
          "#B9B2A4"
        ]
      },
      "legend": {
        "title": null,
        "orient": "bottom",
        "columns": 4,
        "symbolType": "square",
        "labelFontSize": 13,
        "labelLimit": 0
      }
    }
  }
}