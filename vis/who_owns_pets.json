{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Grouped bars compare pet ownership and non-ownership within each demographic group. Complement calculated as 100 minus ownership rate.",
  "data": {
    "url": "data/who_owns_pets.csv"
  },
  "width": "container",
  "height": {
    "step": 38
  },
  "layer": [],
  "config": {
    "view": {
      "stroke": null
    }
  },
  "transform": [
    {
      "fold": [
        "rate",
        "non_owner"
      ],
      "as": [
        "ownership",
        "percent"
      ]
    },
    {
      "calculate": "datum.ownership == 'rate' ? 'Has a pet' : 'Does not have a pet'",
      "as": "status"
    }
  ],
  "encoding": {
    "y": {
      "field": "label",
      "type": "nominal",
      "sort": {
        "field": "rate",
        "order": "descending"
      },
      "axis": {
        "title": null,
        "labelLimit": 285,
        "labelFontSize": 12
      }
    },
    "x": {
      "field": "percent",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          100
        ]
      },
      "axis": {
        "title": "Percentage of people in each group",
        "values": [
          0,
          20,
          40,
          60,
          80,
          100
        ]
      }
    },
    "yOffset": {
      "field": "status",
      "sort": [
        "Has a pet",
        "Does not have a pet"
      ]
    },
    "color": {
      "field": "status",
      "type": "nominal",
      "scale": {
        "domain": [
          "Has a pet",
          "Does not have a pet"
        ],
        "range": [
          "#234B3A",
          "#D8B9A7"
        ]
      },
      "legend": {
        "title": null,
        "orient": "top"
      }
    },
    "tooltip": [
      {
        "field": "group",
        "title": "Group"
      },
      {
        "field": "status",
        "title": "Status"
      },
      {
        "field": "percent",
        "title": "Share (%)",
        "format": ".0f"
      }
    ]
  },
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 2
  }
}