{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Council map fitted to its own boundary; each uses official ABS boundaries.",
  "width": 270,
  "height": 310,
  "title": {
    "text": "Surf Coast \u00b7 VIC",
    "fontSize": 14,
    "anchor": "middle"
  },
  "projection": {
    "type": "mercator",
    "scale": 23942,
    "translate": [
      -60085.8,
      -17215.9
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/council_boundaries.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F4EEE7",
        "stroke": "#A89482",
        "strokeWidth": 0.8
      },
      "transform": [
        {
          "filter": {
            "field": "properties.council",
            "equal": "Surf Coast Shire"
          }
        }
      ]
    },
    {
      "data": {
        "url": "data/suburb_pet_boundaries.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.25,
        "fill": "#EAE1D7"
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.council",
            "title": "Council"
          },
          {
            "field": "properties.suburb",
            "title": "Suburb"
          },
          {
            "field": "properties.Cat",
            "title": "Cats",
            "format": ","
          },
          {
            "field": "properties.Dog",
            "title": "Dogs",
            "format": ","
          },
          {
            "field": "properties.cat_share",
            "title": "Cat share (%)"
          }
        ]
      },
      "transform": [
        {
          "filter": {
            "field": "properties.council",
            "equal": "Surf Coast Shire"
          }
        },
        {
          "filter": "datum.properties.total < 20"
        }
      ]
    },
    {
      "data": {
        "url": "data/suburb_pet_boundaries.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.25
      },
      "encoding": {
        "color": {
          "field": "properties.cat_share",
          "type": "quantitative",
          "title": "Cat share (%)",
          "scale": {
            "domain": [
              0,
              60
            ],
            "range": [
              "#F6E9DC",
              "#6B4433"
            ]
          },
          "legend": {
            "orient": "right",
            "title": "Cats (% of records)"
          }
        },
        "tooltip": [
          {
            "field": "properties.council",
            "title": "Council"
          },
          {
            "field": "properties.suburb",
            "title": "Suburb"
          },
          {
            "field": "properties.Cat",
            "title": "Cats",
            "format": ","
          },
          {
            "field": "properties.Dog",
            "title": "Dogs",
            "format": ","
          },
          {
            "field": "properties.cat_share",
            "title": "Cat share (%)"
          }
        ]
      },
      "transform": [
        {
          "filter": {
            "field": "properties.council",
            "equal": "Surf Coast Shire"
          }
        },
        {
          "filter": "datum.properties.total >= 20"
        }
      ]
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "background": null
  }
}