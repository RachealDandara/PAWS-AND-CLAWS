{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Three independently fitted council maps; each uses official ABS boundaries.",
  "hconcat": [
    {
      "width": 270,
      "height": 310,
      "title": {
        "text": "Townsville \u00b7 QLD",
        "fontSize": 14,
        "anchor": "middle"
      },
      "projection": {
        "type": "mercator"
      },
      "layer": [
        {
          "data": {
            "url": "data/council_boundaries.geojson",
            "format": {
              "type": "json",
              "property": "features"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#F2EEE7",
            "stroke": "#9CA89D",
            "strokeWidth": 0.8
          },
          "transform": [
            {
              "filter": {
                "field": "properties.council",
                "equal": "Townsville City Council"
              }
            }
          ]
        },
        {
          "data": {
            "url": "data/illustrative_pet_dots.csv"
          },
          "mark": {
            "type": "circle",
            "size": 11,
            "opacity": 0.72
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "color": {
              "field": "type",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Cat",
                  "Dog"
                ],
                "range": [
                  "#D9A441",
                  "#234B3A"
                ]
              },
              "title": "Animal"
            },
            "tooltip": [
              {
                "field": "council"
              },
              {
                "field": "suburb"
              },
              {
                "field": "type"
              }
            ]
          },
          "transform": [
            {
              "filter": {
                "field": "council",
                "equal": "Townsville City Council"
              }
            }
          ]
        }
      ]
    },
    {
