{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 380,
  "projection": {
    "type": "mercator"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "background": null
  },
  "layer": [
    {
      "data": {
        "url": "data/council_boundaries.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F2EEE7",
        "stroke": "#9CA89D",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/illustrative_pet_dots.csv"
      },
      "mark": {
        "type": "circle",
        "size": 11,
        "opacity": 0.72
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "color": {
          "field": "type",
          "type": "nominal",
          "scale": {
            "domain": [
              "Cat",
              "Dog"
            ],
            "range": [
              "#D9A441",
              "#234B3A"
            ]
          },
          "title": "Animal"
        },
        "tooltip": [
          {
            "field": "council"
          },
          {
            "field": "suburb"
          },
          {
            "field": "type"
          }
        ]
      }
    }
  ],
  "title": "Illustrative dot density: cats and dogs (1 dot \u2248 250 records)"
}